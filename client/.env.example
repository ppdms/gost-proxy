# GOST Configuration
# Define GOST servers by numbering them (SERVER1_, SERVER2_, etc.)
# Required per server: CF_CLIENT_ID, CF_CLIENT_SECRET, ADDRESS, LOCAL_PORT

# Server 1
SERVER1_CF_CLIENT_ID=your-client-id-1.access
SERVER1_CF_CLIENT_SECRET=your-client-secret-1
SERVER1_ADDRESS=proxy1.example.com:443
SERVER1_LOCAL_PORT=1081

# Server 2
SERVER2_CF_CLIENT_ID=your-client-id-2.access
SERVER2_CF_CLIENT_SECRET=your-client-secret-2
SERVER2_ADDRESS=proxy2.example.com:443
SERVER2_LOCAL_PORT=1082

# Server 3 (add more as needed)
#SERVER3_CF_CLIENT_ID=your-client-id-3.access
#SERVER3_CF_CLIENT_SECRET=your-client-secret-3
#SERVER3_ADDRESS=proxy3.example.com:443
#SERVER3_LOCAL_PORT=1083

# Optional: HTTP/HTTPS Proxy (uses first server's chain)
# Uncomment to enable HTTP proxy on port 8080
#ENABLE_HTTP_PROXY=true
#HTTP_PROXY_PORT=8080

# Optional: Nextcloud TCP Forwarding (uses first server's chain)
# Uncomment and set your Nextcloud LAN address to enable
#NEXTCLOUD_HOST=nextcloud.lan
#NEXTCLOUD_HTTP_PORT=80
#NEXTCLOUD_HTTPS_PORT=443
