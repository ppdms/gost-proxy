# Cloudflare Access Service Token Credentials
# Get these from: https://one.dash.cloudflare.com
# Navigate to: Access controls > Service credentials > Service Tokens
CF_ACCESS_CLIENT_ID=your-client-id.access
CF_ACCESS_CLIENT_SECRET=your-client-secret-here

# GOST Server Configuration
GOST_SERVER_ADDRESS=proxy.example.com:443
GOST_SERVER_HOSTNAME=proxy.example.com

# Local SOCKS5 port (optional - defaults to 1080)
GOST_LOCAL_PORT=1080
